# API Keys
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# ─── Model roles ───────────────────────────────────────────────────────────────
# Use stronger models for planning/synthesis, cheaper for loops/summarisation
SCOPE_MODEL=gpt-4o
ORCHESTRATOR_MODEL=gpt-4o
RESEARCHER_MODEL=gpt-4o-mini
PAGE_SUMMARIZER_MODEL=gpt-4o-mini
WRITER_MODEL=gpt-4o

# ─── Budget / safety limits ────────────────────────────────────────────────────
MAX_RESEARCH_ITERATIONS=2
MAX_CONCURRENT_RESEARCHERS=5
MAX_ORCHESTRATOR_STEPS=8
MAX_RESEARCHER_STEPS=20
MAX_SEARCH_RESULTS=10
MAX_CONTENT_LENGTH=50000
MAX_LLM_CALLS=30
MAX_RETRIES=3

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
